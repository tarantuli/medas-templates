{
  "name": "morphp/medas-templates",
  "description": "Medas templates: {{ key | pipe:argument }} interpolation with typed, localised pipes, and entities compiled into template variables",
  "keywords": [
    "templating",
    "rendering"
  ],
  "authors": [
    {
      "name": "Patrick Morpey",
      "email": "patrick@morphp.nl"
    }
  ],
  "type": "library",
  "require": {
    "ext-ctype": "*",
    "ext-intl": "*",
    "morphp/medas-core": "^4.4",
    "morphp/medas-entity-manager": "^3.10",
    "php": "^8.4"
  },
  "require-dev": {
    "morphp/medas-object-instantiator": "^4",
    "morphp/medas-service-manager": "^4",
    "phpunit/phpunit": "^10"
  },
  "autoload": {
    "psr-4": {
      "Medas\\Templates\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Medas\\TemplatesTest\\": "tests/"
    }
  }
}
